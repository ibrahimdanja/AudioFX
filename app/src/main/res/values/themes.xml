<resources>
    <style name="Theme.Equalizer314" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#12141A</item>
        <item name="android:navigationBarColor">#12141A</item>
        <item name="android:windowBackground">#12141A</item>
    </style>

    <style name="Theme.AudioFXStudio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#6984FF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#57CFB7</item>
        <item name="colorOnSecondary">#071B18</item>
        <item name="colorSurface">#0D111B</item>
        <item name="colorOnSurface">#F0F3FA</item>
        <item name="android:windowBackground">#0D111B</item>
        <item name="android:statusBarColor">#0D111B</item>
        <item name="android:navigationBarColor">#0D111B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="ThemeOverlay.Equalizer314.Amoled" parent="">
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="colorSurface">#FF000000</item>
        <item name="colorSurfaceDim">#FF000000</item>
        <item name="colorSurfaceBright">#FF1A1A1A</item>
        <item name="colorSurfaceVariant">#FF0F0F0F</item>
        <item name="colorSurfaceContainerLowest">#FF000000</item>
        <item name="colorSurfaceContainerLow">#FF060606</item>
        <item name="colorSurfaceContainer">#FF0C0C0C</item>
        <item name="colorSurfaceContainerHigh">#FF141414</item>
        <item name="colorSurfaceContainerHighest">#FF1A1A1A</item>
    </style>
    <style name="Theme.Equalizer314.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textColorPrimary">#FFE2E2E2</item>
        <item name="android:textColorSecondary">#FFBBBBBB</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Equalizer314.DialogButtonNegative</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Equalizer314.DialogButtonReset</item>
    </style>
    <style name="Widget.Equalizer314.DialogButtonReset" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#FFEF9A9A</item>
        <item name="strokeColor">#FF444444</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Widget.Equalizer314.DialogButtonNegative" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#FFDDDDDD</item>
        <item name="strokeColor">#FF444444</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="TextAppearance.Equalizer314.Suffix" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ShapeAppearanceOverlay.Equalizer314.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.Equalizer314.FAB.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.SpectrumButton" parent="">
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
    </style>
    <style name="ShapeAppearance.MbcEqButton" parent="">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
    </style>
    <style name="ShapeAppearance.MbcGrButton" parent="">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.ResetButton" parent="">
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
    </style>
</resources>
